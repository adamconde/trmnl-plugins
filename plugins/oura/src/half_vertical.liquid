<div class="layout">
  {% comment %} Two columns; five or six tiles (three rows) drop the status and bars to keep the rings readable. {% endcomment %}
  {% assign cols = tiles.size | at_most: 2 | at_least: 1 %}
  {% if tiles.size > 4 %}{% assign size = "sm" %}{% else %}{% assign size = "md" %}{% endif %}
  {% render "tiles", has_data: has_data, tiles: tiles, max: 6, cols: cols, size: size %}
</div>

{% render "title_bar", date: date, updated: updated %}
