<div class="layout">
  {% if has_data %}
  {% comment %} 7 narrow columns need small cards; the 5-column bracket has room for medium. {% endcomment %}
  {% if bracket.show_wc %}{% assign size = "sm" %}{% else %}{% assign size = "md" %}{% endif %}
  <div class="mlb-bracket{% unless bracket.show_wc %} mlb-bracket--no-wc{% endunless %}">
    {% if bracket.show_wc %}{% render "round_column", area: "al-wc", header: "AL WC", list: bracket.al.wc, size: size %}{% endif %}
    {% render "round_column", area: "al-ds", header: "ALDS", list: bracket.al.ds, size: size %}
    {% render "round_column", area: "al-cs", header: "ALCS", list: bracket.al.cs, size: size %}
    {% render "round_column", area: "ws", header: "World Series", single: bracket.ws, size: size %}
    {% render "round_column", area: "nl-cs", header: "NLCS", list: bracket.nl.cs, size: size %}
    {% render "round_column", area: "nl-ds", header: "NLDS", list: bracket.nl.ds, size: size %}
    {% if bracket.show_wc %}{% render "round_column", area: "nl-wc", header: "NL WC", list: bracket.nl.wc, size: size %}{% endif %}
  </div>
  {% else %}
  <span class="title">No postseason schedule yet</span>
  {% endif %}
</div>

{% render "title_bar", updated: updated, subtitle: current.name %}
