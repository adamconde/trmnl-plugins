{% comment %}
  Card sizes: "sm" for the dense bracket, "md" (default), "lg" where the view has room.
  Each size steps up one more on large screens (lg:, e.g. TRMNL X), which also show the game number.
  `details: false` leaves out probable starters and venue, for views too short to fit them.
{% endcomment %}

{% comment %} One team line: logo, abbreviation (probable starter beneath before a game), series wins as dots (none for unresolved slots), live game score. {% endcomment %}
{% template team_row %}
{% case size %}
  {% when "sm" %}{% assign logo = "w--4 h--4 lg:w--6 lg:h--6" %}{% assign abbr_class = "label lg:label--large" %}{% assign dots = "xsmall lg:progress-dots--small" %}{% assign score_class = "value--xxsmall lg:value--small" %}
  {% when "lg" %}{% assign logo = "w--7 h--7 lg:w--10 lg:h--10" %}{% assign abbr_class = "title lg:title--large" %}{% assign dots = "base lg:progress-dots--large" %}{% assign score_class = "value--small lg:value--large" %}
  {% else %}{% assign logo = "w--5 h--5 lg:w--8 lg:h--8" %}{% assign abbr_class = "label lg:label--large" %}{% assign dots = "small lg:progress-dots--base" %}{% assign score_class = "value--xsmall lg:value" %}
{% endcase %}
<div class="flex flex--row flex--center-y gap--xsmall lg:gap--small">
  {% if team.placeholder %}<span class="{{ logo }}"></span>{% else %}<img class="image-dither {{ logo }}" src="https://www.mlbstatic.com/team-logos/team-cap-on-light/{{ team.id }}.svg">{% endif %}
  <div class="flex flex--col flex--stretch-x grow">
    <span class="{{ abbr_class }}{% if team.winner %} text--bold{% elsif team.eliminated %} text--gray-4{% endif %}">{{ team.abbr }}</span>
    {% if details and series.state == "scheduled" %}{% unless team.placeholder %}<span class="description lg:description--large" data-clamp="1">{{ team.pitcher | default: "TBD" }}</span>{% endunless %}{% endif %}
  </div>
  {% unless team.placeholder %}
  {% assign needed = series.best_of | divided_by: 2 | plus: 1 %}
  <span class="progress-dots progress-dots--{{ dots }} flex flex--row gap--xsmall">
    {% for i in (1..needed) %}<span class="dot{% if i <= team.wins %} dot--filled{% endif %}"></span>{% endfor %}
  </span>
  {% endunless %}
  {% if series.state == "live" %}<span class="value {{ score_class }} value--tnums">{{ team.score }}</span>{% endif %}
</div>
{% endtemplate %}

{% comment %} Series box: both teams plus live inning, next game time, or result (stacked on two lines in narrow bracket columns). {% endcomment %}
{% template series_card %}
{% assign size = size | default: "md" %}
{% if details == nil %}{% assign details = true %}{% endif %}
<div class="outline p--1 lg:p--2 flex flex--col flex--stretch-x flex--around gap--small lg:gap--medium">
  {% for team in series.teams %}{% render "team_row", team: team, series: series, size: size, details: details %}{% endfor %}
  <div class="flex {% if stacked %}flex--col portrait:flex--row{% else %}flex--row{% endif %} flex--center gap--xsmall">
    {% if series.status.game %}<span class="description lg:description--large hidden lg:visible">{{ series.status.game }}</span>{% endif %}
    {% case series.state %}
    {% when "live" %}<span class="label label--small label--inverted">LIVE</span><span class="description lg:description--large">{{ series.status.inning }}</span>
    {% when "final" %}<span class="description lg:description--large">{{ series.status.result }}</span>
    {% else %}<span class="description lg:description--large">{{ series.status.date }}</span>{% if series.status.time %}<span class="description lg:description--large">{{ series.status.time }}</span>{% endif %}
    {% endcase %}
  </div>
  {% if details and series.status.venue %}<span class="description lg:description--large text--center" data-clamp="1">{{ series.status.venue }}</span>{% endif %}
</div>
{% endtemplate %}

{% comment %} One bracket column: round header plus its series (a list, or a single World Series), cards at `size`, spread down the column. {% endcomment %}
{% template round_column %}
<div class="flex flex--col flex--stretch-x gap--small w--full">
  <span class="label label--small lg:label--large label--underline">{{ header }}</span>
  <div class="flex flex--col flex--stretch-x flex--around grow gap--small">
    {% for series in list %}{% render "series_card", series: series, size: size, stacked: true %}{% endfor %}
    {% if single %}{% render "series_card", series: single, size: size, stacked: true %}{% endif %}
  </div>
</div>
{% endtemplate %}

{% comment %} Current round (AL then NL series from the bracket) as a grid of cards filling the view, for the smaller layouts. {% endcomment %}
{% template current_round %}
{% if has_data %}
{% if current.key == "ws" %}
  {% assign count = 1 %}
{% else %}
  {% assign count = bracket.al[current.key].size | plus: bracket.nl[current.key].size %}
{% endif %}
{% if count < cols %}{% assign cols = count %}{% endif %}
<div class="grid grid--cols-{{ cols }}{% if cols > 2 %} portrait:grid--cols-2{% endif %} gap--small w--full h--full">
  {% if current.key == "ws" %}
  {% render "series_card", series: bracket.ws, size: size, details: details %}
  {% else %}
  {% for series in bracket.al[current.key] %}{% render "series_card", series: series, size: size, details: details %}{% endfor %}
  {% for series in bracket.nl[current.key] %}{% render "series_card", series: series, size: size, details: details %}{% endfor %}
  {% endif %}
</div>
{% else %}
<span class="title">No postseason schedule yet</span>
{% endif %}
{% endtemplate %}

{% template title_bar %}
<div class="title_bar">
  <span class="title">MLB Playoffs</span>
  <span class="instance">{% if subtitle %}{{ subtitle }} · {% endif %}Updated {{ updated }}</span>
</div>
{% endtemplate %}
